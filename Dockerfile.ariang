# Build stage
FROM alpine:latest AS builder

ARG ARIANG_VERSION

RUN apk add --no-cache curl unzip \
    && curl -fsSL -o /tmp/ariang.zip \
       https://github.com/mayswind/AriaNg/releases/download/${ARIANG_VERSION}/AriaNg-${ARIANG_VERSION}.zip \
    && unzip -o /tmp/ariang.zip -d /tmp/ariang

# Final stage
FROM caddy:alpine

COPY --from=builder /tmp/ariang /usr/share/caddy

EXPOSE 80

CMD ["caddy", "file-server", "--root", "/usr/share/caddy"]
